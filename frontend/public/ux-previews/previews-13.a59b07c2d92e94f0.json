</button>`).join('')).join('');function paint(){qa('.pad').forEach(b=>{b.setAttribute('aria-pressed',active.has(+b.dataset.i));b.classList.toggle('playhead',+b.dataset.i%8===step)})}function stop(){clearInterval(timer);timer=null;step=-1;q('.play').textContent='▶';q('.play').setAttribute('aria-label','스텝 재생');q('.play').setAttribute('aria-pressed',false);paint()}qa('.pad').forEach(b=>b.onclick=()=>{const i=+b.dataset.i;active.has(i)?active.delete(i):active.add(i);paint()});q('.play').onclick=()=>{if(timer){stop();return}q('.play').textContent='Ⅱ';q('.play').setAttribute('aria-label','재생 정지');q('.play').setAttribute('aria-pressed',true);step=0;paint();timer=setInterval(()=>{if(!root.isConnected){stop();return}step=(step+1)%8;paint()},250)};root.onkeydown=e=>{if(e.key==='Escape'){stop();active=new Set([0,4,10,14,16,20]);paint()}};document.addEventListener('visibilitychange',()=>{if(document.hidden)stop()});paint();})();","demo":[["wait",500],["tap",".u112 .pad[data-i=\"2\"]",0],["wait",400],["tap",".u112 .play",0],["wait",2600],["tap",".u112 .play",0],["wait",500],["tap",".u112 .pad[data-i=\"2\"]",0],["wait",900]],"map":[["'킥','스네어','햇'","'Kick','Snare','Hat'"],["${i+1}번 스텝","step ${i+1}"],["스텝 재생","Play steps"],["재생 정지","Stop playback"]]}]}