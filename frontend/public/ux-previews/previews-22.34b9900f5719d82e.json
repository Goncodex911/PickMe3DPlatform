{"items":[{"id":"177","html":"<style>\n.u177{position:relative;width:340px;height:356px;padding:16px;box-sizing:border-box;border-radius:28px;background:var(--ux-surface);box-shadow:0 0 0 1px var(--ux-line),0 30px 60px -36px var(--ux-shadow-strong);color:var(--ux-ink);font-variant-numeric:tabular-nums}\n.u177-st{position:relative;height:132px;border-radius:16px;background:radial-gradient(var(--ux-line) 1px,transparent 1.5px) 0 0/14px 14px,var(--ux-surface-2);overflow:hidden}\n.u177-sh{position:absolute;left:50%;top:50%;width:64px;height:64px;margin:-32px 0 0 -32px;background:var(--c,#4D78C9);box-shadow:0 14px 22px -12px var(--c,#4D78C9);transition:transform .55s cubic-bezier(.3,1.35,.5,1),border-radius .5s var(--ux-spring),background-color .4s,box-shadow .4s}\n.u177-ch{position:absolute;left:10px;top:10px;padding:4px 9px;border-radius:999px;background:var(--ux-surface);box-shadow:0 0 0 1px var(--ux-line);font-size:11px;font-weight:750;color:var(--ux-ink-2)}\n.u177-ch.pop{animation:u177-pop .4s var(--ux-spring)}\n@keyframes u177-pop{from{opacity:0;transform:translateY(-6px) scale(.9)}}\n.u177-tools{display:flex;gap:6px;margin-top:10px}\n.u177-tl{flex:1;height:34px;border:0;border-radius:10px;background:var(--ux-surface-2);color:var(--ux-ink);font-size:12px;font-weight:750;display:flex;align-items:center;justify-content:center;gap:5px;transition:transform .25s var(--ux-spring),background-color .2s}\n.u177-tl:hover{background:color-mix(in srgb,var(--ux-ink) 9%,var(--ux-surface-2))}\n.u177-tl:active{transform:scale(.94)}\n.u177-tl i{font-style:normal;color:#4D78C9}\n.u177-gr{position:relative;height:104px;margin-top:10px;border-radius:14px;box-shadow:inset 0 0 0 1px var(--ux-line);overflow:hidden}\n.u177-cv{position:absolute;left:0;top:0;height:100%;transition:transform .45s var(--ux-ease)}\n.u177-cv svg{position:absolute;left:0;top:0;width:600px;height:104px;overflow:visible}\n.u177-cv path{fill:none;stroke-width:2;transition:stroke .3s,opacity .3s}\n.u177-nd{position:absolute;left:0;top:0;width:24px;height:24px;margin:-12px 0 0 -12px;border:0;padding:0;border-radius:50%;background:#4D78C9;color:#fff;font-size:10px;font-weight:900;line-height:24px;transition:transform .45s cubic-bezier(.3,1.25,.5,1),background-color .3s,opacity .3s,box-shadow .3s}\n.u177-nd.fut{background:var(--ux-surface);color:#4D78C9;box-shadow:inset 0 0 0 2px #4D78C9;opacity:.7}\n.u177-nd.side{background:var(--ux-surface);color:var(--ux-ink-3);box-shadow:inset 0 0 0 1.5px var(--ux-line-2)}\n.u177-nd.cur{box-shadow:0 0 0 3px var(--ux-surface),0 0 0 5.5px #4D78C9}\n.u177-nd.cur::after{content:\"\";position:absolute;inset:-9px;border-radius:50%;border:2px solid #4D78C9;opacity:0;animation:u177-ring 1.6s ease-out infinite}\n@keyframes u177-ring{0%{opacity:.6;transform:scale(.7)}100%{opacity:0;transform:scale(1.35)}}\n.u177-nd.new{animation:u177-in .45s cubic-bezier(.3,1.5,.5,1)}\n@keyframes u177-in{from{scale:0}}\n.u177-nd:focus-visible,.u177-tl:focus-visible,.u177-bt button:focus-visible{outline:2px solid var(--ux-accent);outline-offset:3px}\n.u177-bt{display:flex;align-items:center;gap:8px;margin-top:10px}\n.u177-bt button{width:38px;height:32px;border:0;border-radius:10px;background:var(--ux-ink);color:var(--ux-surface);font-size:17px;font-weight:700;transition:opacity .2s,transform .25s var(--ux-spring)}\n.u177-bt button:disabled{opacity:.25}\n.u177-bt button:not(:disabled):active{transform:scale(.92)}\n.u177-bt span{margin-left:auto;font-size:11.5px;font-weight:700;color:var(--ux-ink-3)}\n</style>\n<div class=\"ux u177\">\n  <div class=\"u177-st\"><div class=\"u177-sh\" role=\"img\" aria-label=\"편집 중인 도형\"></div><span class=\"u177-ch\" aria-live=\"polite\"></span></div>\n  <div class=\"u177-tools\" role=\"group\" aria-label=\"편집 도구\"></div>\n  <div class=\"u177-gr\" role=\"group\" aria-label=\"작업 기록\"><div class=\"u177-cv\"><svg aria-hidden=\"true\"></svg></div></div>\n  <div class=\"u177-bt\"><button class=\"u177-un\" type=\"button\" aria-label=\"실행 취소\">↶</button><button class=\"u177-rd\" type=\"button\" aria-label=\"다시 실행\">↷</button><span></span></div>\n</div>","js":"(function () {\n  var root = document.currentScript.previousElementSibling;\n  var sh = root.querySelector('.u177-sh'), chip = root.querySelector('.u177-ch'), tools = root.querySelector('.u177-tools'), cv = root.querySelector('.u177-cv'), svg = cv.querySelector('svg');\n  var un = root.querySelector('.u177-un'), rd = root.querySelector('.u177-rd'), info = root.querySelector('.u177-bt span');\n  var KIND = [['색', '●'], ['모양', '◆'], ['회전', '↻'], ['크기', '⤢']];\n  var HUE = ['#4D78C9', '#E8590C', '#2B8A3E', '#C2255C', '#7048E8'], RAD = ['16px', '50%', '42px 10px'], SC = [1, 1.3, 0.78];\n  var NS = 'http://www.w3.org/2000/svg', DX = 34, X0 = 22;\n  // 기록은 나무입니다. 마디마다 부모, 그때의 도형 상태, 마지막으로 다녀온 자식을 기억합니다\n  var nodes = [{ id: 0, p: -1, s: { h: 0, f: 0, r: 0, z: 0 }, k: -1, kids: [], last: -1 }], cur = 0;\n  KIND.forEach(function (kd, i) {\n    var b = document.createElement('button'); b.type = 'button'; b.className = 'u177-tl';\n    b.innerHTML = '<i aria-hidden=\"true\">' + kd[1] + '</i><span></span>'; b.querySelector('span').textContent = kd[0];\n    b.addEventListener('click', function () { edit(i); });\n    tools.appendChild(b);\n  });\n  function depth(id) { var d = 0; while (nodes[id].p >= 0) { id = nodes[id].p; d++; } return d; }\n  function label(n) { return n.k < 0 ? '시작' : KIND[n.k][0]; }\n  function say(t) { chip.textContent = t; chip.classList.remove('pop'); void chip.offsetWidth; chip.classList.add('pop'); }\n  function apply() {\n    var s = nodes[cur].s;\n    sh.style.setProperty('--c', HUE[s.h]);\n    sh.style.borderRadius = RAD[s.f];\n    sh.style.transform = 'rotate(' + s.r + 'deg) scale(' + SC[s.z] + ')';\n  }\n  function edit(k) {\n    var n = nodes[cur], s = { h: n.s.h, f: n.s.f, r: n.s.r, z: n.s.z };\n    if (k === 0) s.h = (s.h + 1) % HUE.length;\n    if (k === 1) s.f = (s.f + 1) % RAD.length;\n    if (k === 2) s.r += 45;\n    if (k === 3) s.z = (s.z + 1) % SC.length;\n    var branch = n.kids.length > 0;\n    var m = { id: nodes.length, p: cur, s: s, k: k, kids: [], last: -1 };\n    nodes.push(m); n.kids.push(m.id); n.last = m.id; cur = m.id;\n    say((branch ? '새 가지 · ' : '') + KIND[k][0]);\n    render(m.id); apply();\n  }\n  function go(id, why) {\n    cur = id;\n    // 지금 마디까지의 길을 '마지막으로 다녀온 길'로 기록해 두어야 다시 실행이 이 길을 따라갑니다\n    for (var c = id; nodes[c].p >= 0; c = nodes[c].p) nodes[nodes[c].p].last = c;\n    say(why + label(nodes[id]));\n    render(-1); apply();\n  }\n  un.addEventListener('click', function () { if (nodes[cur].p >= 0) { var l = label(nodes[cur]); cur = nodes[cur].p; say('실행 취소 · ' + l); render(-1); apply(); } });\n  rd.addEventListener('click', function () { var n = nodes[cur]; if (n.last >= 0) go(n.last, '다시 실행 · '); });\n  root.addEventListener('keydown', function (e) {\n    if (!(e.metaKey || e.ctrlKey) || e.key.toLowerCase() !== 'z') return;\n    e.preventDefault(); (e.shiftKey ? rd : un).click();\n  });\n  var btns = [];\n  function render(fresh) {\n    // 지금 마디에서 '마지막 자식'을 따라 끝까지 간 길이 맨 윗줄(지금 가지)이고, 나머지 가지는 아랫줄에 놓입니다\n    var main = [], c = 0;\n    var path = []; for (var a = cur; a >= 0; a = nodes[a].p) path.unshift(a);\n    main = path.slice();\n    for (c = cur; nodes[c].last >= 0; c = nodes[c].last) main.push(nodes[c].last);\n    var row = {}, rows = 1;\n    main.forEach(function (id) { row[id] = 0; });\n    main.forEach(function (id) {\n      nodes[id].kids.forEach(function (k) {\n        if (row[k] != null) return;\n        var r = Math.min(rows, 2); if (rows < 3) rows++;\n        // 곁가지는 그 가지에서 마지막으로 다녀온 길을 따라 한 줄로 펼칩니다\n        for (var q = k; q >= 0; q = nodes[q].last) { row[q] = r; nodes[q].kids.forEach(function (z) { if (row[z] == null && z !== nodes[q].last) row[z] = r; }); }\n      });\n    });\n    nodes.forEach(function (n) { if (row[n.id] == null) row[n.id] = 2; });\n    svg.innerHTML = '';\n    var past = {}; path.forEach(function (id) { past[id] = true; });\n    var maxX = 0;\n    nodes.forEach(function (n) {\n      var xx = X0 + depth(n.id) * DX, yy = 22 + row[n.id] * 32;\n      n.x = xx; n.y = yy; maxX = Math.max(maxX, xx);\n      if (n.p >= 0) {\n        var p = nodes[n.p], d = document.createElementNS(NS, 'path');\n        d.setAttribute('d', p.y === yy ? 'M' + p.x + ' ' + p.y + 'H' + xx : 'M' + p.x + ' ' + p.y + 'C' + (p.x + DX * 0.6) + ' ' + p.y + ' ' + (xx - DX * 0.6) + ' ' + yy + ' ' + xx + ' ' + yy);\n        var onMain = row[n.id] === 0;\n        d.setAttribute('stroke', onMain ? '#4D78C9' : 'var(--ux-line-2)');\n        if (!past[n.id]) d.setAttribute('stroke-dasharray', onMain ? '4 4' : '3 4');\n        if (onMain && !past[n.id]) d.setAttribute('opacity', '.55');\n        svg.appendChild(d);\n      }\n      var b = btns[n.id];\n      if (!b) {\n        b = document.createElement('button'); b.type = 'button'; b.className = 'u177-nd';\n        b.addEventListener('click', function () { if (n.id !== cur) go(n.id, '되돌아감 · '); });\n        cv.appendChild(b); btns[n.id] = b;\n        // 새 마디는 부모 자리에서 태어나 제자리로 미끄러집니다\n        var from = fresh === n.id && n.p >= 0 ? nodes[n.p] : n;\n        b.style.transition = 'none'; b.style.transform = 'translate(' + from.x + 'px,' + from.y + 'px)';\n        void b.offsetWidth; b.style.transition = '';\n        if (fresh === n.id) b.classList.add('new');\n      }\n      b.textContent = n.k < 0 ? '○' : KIND[n.k][1];\n      b.style.transform = 'translate(' + xx + 'px,' + yy + 'px)';\n      b.className = 'u177-nd' + (n.id === cur ? ' cur' : '') + (row[n.id] > 0 ? ' side' : !past[n.id] ? ' fut' : '') + (b.classList.contains('new') && fresh === n.id ? ' new' : '');\n      b.setAttribute('aria-label', depth(n.id) + '단계: ' + label(n) + ', 이 상태로 돌아가기');\n      b.setAttribute('aria-current', n.id === cur ? 'step' : 'false');\n    });\n    // 지금 마디가 오른쪽 끝을 넘으면 기록판을 왼쪽으로 밀어 따라갑니다\n    var shift = Math.max(0, nodes[cur].x - (308 - 60));\n    cv.style.transform = 'translateX(' + (-shift) + 'px)';\n    un.disabled = nodes[cur].p < 0; rd.disabled = nodes[cur].last < 0;\n    var branches = nodes.filter(function (n) { return n.kids.length > 1; }).reduce(function (s, n) { return s + n.kids.length - 1; }, 0);\n    info.textContent = (branches ? '가지 ' + (branches + 1) + '개 · ' : '') + depth(cur) + ' / 전체 ' + (main.length - 1) + '단계';\n  }\n  say('시작'); render(-1); apply();\n})();","demo":[["wait",700],["tap",".u177-tl",0,{"after":800}],["tap",".u177-tl",2,{"after":800}],["tap",".u177-tl",1,{"after":900}],["tap",".u177-un",0,{"after":800}],["tap",".u177-un",0,{"after":1000}],["tap",".u177-tl",3,{"after":1500}],["tap",".u177-nd",3,{"after":1600}],["tap",".u177-rd",0,{"after":1200}]],"map":[["var KIND = [['색', '●'], ['모양', '◆'], ['회전', '↻'], ['크기', '⤢']];","var KIND = [['Color', '●'], ['Shape', '◆'], ['Rotate', '↻'], ['Size', '⤢']];"],["'시작'","'Start'"],["'단계: '","': '"],["', 이 상태로 돌아가기'","', go to this state'"],["'실행 취소 · '","'Undo · '"],["'다시 실행 · '","'Redo · '"],["'새 가지 · '","'New branch · '"],["'되돌아감 · '","'Jumped to · '"],["'가지 '","'Branches: '"],["'개 · '","' · '"],["' / 전체 '","' of '"],["'단계'","' steps'"],["aria-label=\"편집 도구\"","aria-label=\"Edit tools\""],["aria-label=\"작업 기록\"","aria-label=\"Edit history\""],["aria-label=\"실행 취소\"","aria-label=\"Undo\""],["aria-label=\"다시 실행\"","aria-label=\"Redo\""],["aria-label=\"편집 중인 도형\"","aria-label=\"Shape being edited\""]]},{"id":"178","html":"<style>\n.u178 {width:100%;max-width:370px;font-size:14px;line-height:1.45;position:relative;--a:#cd5339;--soft:color-mix(in srgb,var(--a) 12%,var(--ux-surface));font-variant-numeric:tabular-nums}\n.u178 button{border:1px solid var(--ux-line-2);background:var(--ux-surface);border-radius:9px;padding:9px 12px;min-height:38px;transition:background .2s,transform .3s,color .2s;color:var(--ux-ink)}\n.u178 button:active{transform:translateY(1px)}.u178 button:disabled{opacity:.4;cursor:default}.u178 button.primary{background:var(--ux-ink);color:var(--ux-page);border-color:transparent}\n.u178 .muted{color:var(--ux-ink-2);font-size:12px}.u178 .eyebrow{font:600 10px/1.2 ui-monospace,monospace;letter-spacing:.12em;text-transform:uppercase;color:var(--ux-ink-2)}\n.u178 .row{display:flex;align-items:center;justify-content:space-between;gap:8px}.u178 .actions{display:flex;gap:8px;align-items:center;margin-top:16px;flex-wrap:wrap}\n.u178 input,.u178 select{max-width:100%;min-width:0;background:var(--ux-surface);color:var(--ux-ink);border:1px solid var(--ux-line-2);border-radius:7px;padding:8px;font:inherit}\n.u178 output{font-variant-numeric:tabular-nums}.u178 :focus-visible{outline:2px solid var(--ux-accent);outline-offset:3px}\n@media(prefers-reduced-motion:reduce){.u178 *,.u178 *::before,.u178 *::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}\n.u178 .files{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin:19px 0}.u178 .file{height:103px;position:relative;text-align:left;padding:12px 9px;background:var(--ux-surface-2);transition:transform .3s,background .3s}.u178 .file[aria-pressed=true]{background:color-mix(in srgb,#cf8a31 19%,var(--ux-surface));border-color:#b87623;transform:translateY(-4px)}.u178 .file i{display:block;font-style:normal;font:bold 11px ui-monospace,monospace;color:light-dark(#855210,#efbd78);margin-bottom:15px}.u178 .file span{font-size:11px;display:block}.u178 .file::after{content:'+';position:absolute;right:9px;top:6px;color:var(--ux-ink-2)}.u178 .file[aria-pressed=true]::after{content:'✓'}.u178 .dock{display:flex;align-items:center;justify-content:space-between;gap:6px;padding:10px 12px;border-radius:14px;background:var(--ux-ink);color:var(--ux-page);transform:translateY(7px);opacity:.55;transition:all .35s}.u178 .dock.active{transform:none;opacity:1}.u178 .dock button{background:var(--ux-page);color:var(--ux-ink);padding:6px 10px;font-size:12px}.u178 .restore{border:0;background:none;font-size:12px;padding:0;min-height:30px}\n\n/* Focused composition */\n.u178{max-widt