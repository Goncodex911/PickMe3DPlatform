max(0, 1 - (m - 561) / 11);\n  }\n  var SER = []; for (var m = 470; m <= 730; m += 1) SER.push([m, rate(m)]);\n  function x(m) { return (m - dom[0]) / (dom[1] - dom[0]) * W; }\n  function y(v) { return 112 - v / 13.5 * 100; }\n  function fmt(m) { var h = Math.floor(m / 60), mm = Math.round(m % 60); return (h < 10 ? '0' : '') + h + ':' + (mm < 10 ? '0' : '') + mm; }\n  var evs = EV.map(function (e, i) {\n    var b = document.createElement('button'); b.type = 'button'; b.className = 'u170-ev';\n    b.style.setProperty('--c', e[3]); b.textContent = ICON[i]; b.setAttribute('data-l', e[1]);\n    b.setAttribute('aria-label', fmt(e[0]) + ' ' + e[1]);\n    b.addEventListener('click', function () { pick(i); });\n    b.addEventListener('keydown', function (k) {\n      var d = k.key === 'ArrowRight' ? 1 : k.key === 'ArrowLeft' ? -1 : 0;\n      if (!d) return;\n      k.preventDefault();\n      var n = Math.max(0, Math.min(EV.length - 1, (sel < 0 ? i : sel) + d));\n      if (!evs[n].classList.contains('hid')) { pick(n); evs[n].focus(); }\n    });\n    ch.appendChild(b);\n    return b;\n  });\n  var cl = document.createElement('button'); cl.type = 'button'; cl.className = 'u170-cl'; ch.appendChild(cl);\n  cl.addEventListener('click', function () { zoomTo(true); });\n  function draw() {\n    var pts = SER.filter(function (p) { return p[0] >= dom[0] - 2 && p[0] <= dom[1] + 2; }).map(function (p) { return x(p[0]).toFixed(1) + ' ' + y(p[1]).toFixed(1); });\n    ln.setAttribute('d', 'M' + pts.join(' L'));\n    ar.setAttribute('d', 'M' + pts[0].split(' ')[0] + ' 112 L' + pts.join(' L') + ' L' + pts[pts.length - 1].split(' ')[0] + ' 112Z');\n    bd.setAttribute('x', x(540).toFixed(1)); bd.setAttribute('width', (x(572) - x(540)).toFixed(1));\n    // 눈금 간격은 보이는 범위에 따라 30분 → 10분 → 5분으로 촘촘해집니다\n    // 눈금 글자가 42px보다 가까워지지 않는 가장 촘촘한 간격을 고릅니다\n    var span = dom[1] - dom[0], step = [5, 10, 15, 30, 60].filter(function (s) { return s / span * W >= 42; })[0] || 60;\n    tk.innerHTML = '';\n    for (var t = Math.ceil(dom[0] / step) * step; t <= dom[1]; t += step) {\n      var tx = x(t);\n      if (tx < 14 || tx > W - 14) continue;\n      var l = document.createElementNS(NS, 'line'); l.setAttribute('x1', tx); l.setAttribute('x2', tx); l.setAttribute('y1', 112); l.setAttribute('y2', 116); l.setAttribute('stroke', 'var(--ux-line-2)'); tk.appendChild(l);\n      var s = document.createElementNS(NS, 'text'); s.setAttribute('x', tx); s.setAttribute('y', 129); s.setAttribute('text-anchor', 'middle'); s.textContent = fmt(t); tk.appendChild(s);\n    }\n    var xs = EV.map(function (e) { return x(e[0]); });\n    evs.forEach(function (b, i) {\n      var ex = xs[i], gap = Math.min.apply(null, xs.map(function (o, k) { return k === i ? 1e9 : Math.abs(o - ex); }));\n      b.style.left = ex.toFixed(1) + 'px'; b.style.display = ex < -20 || ex > W + 20 ? 'none' : '';\n      // 이웃 사건과 27px보다 가까우면 이름표를 숨겨 글자가 겹치지 않게 합니다\n      b.style.setProperty('--lo', gap < 27 ? '0' : '1');\n    });\n    mmw.style.left = ((dom[0] - FULL[0]) / 240 * 100) + '%'; mmw.style.width = ((dom[1] - dom[0]) / 240 * 100) + '%';\n  }\n  // 전체 보기에서 22px 안쪽으로 겹치는 사건들은 묶음 하나로 바꿉니다\n  function cluster(show) {\n    var group = [];\n    if (show) EV.forEach(function (e, i) { if (e[0] >= 538 && e[0] <= 575) group.push(i); });\n    evs.forEach(function (b, i) { b.classList.toggle('hid', group.indexOf(i) >= 0); });\n    cl.classList.toggle('show', group.length > 0);\n    if (group.length) {\n      var cx = group.reduce(function (s, i) { return s + x(EV[i][0]); }, 0) / group.length;\n      cl.style.left = cx.toFixed(1) + 'px'; cl.textContent = group.length;\n      cl.setAttribute('aria-label', '사건 ' + group.length + '개, 눌러서 확대');\n    }\n  }\n  function detail() {\n    var t = dt.querySelector('time'), s = dt.querySelector('span');\n    if (sel < 0) { t.textContent = '요약'; dt.style.removeProperty('--c'); s.textContent = '감지 → 회복 32분 · 최고 오류율 12.4%'; }\n    else { var e = EV[sel]; t.textContent = fmt(e[0]); dt.style