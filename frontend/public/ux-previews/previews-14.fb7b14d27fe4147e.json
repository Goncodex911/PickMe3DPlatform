nt();})();","demo":[["wait",500],["drag",".u113 .pixel",1,[0.5,0.5],[5.6,0.5],900],["wait",700],["tap",".u113 .pixel",27],["wait",900],["key",".u113 .pixel",0,"Escape",1,1000]],"map":[["8 × 8 픽셀 아이콘","8 × 8 pixel icon"],["${Math.floor(i/8)+1}행 ${i%8+1}열","row ${Math.floor(i/8)+1}, column ${i%8+1}"]]},{"id":"114","html":"<style>\n.u114{width:100%;max-width:400px;min-width:0;font-size:13px}.u114 button{font:inherit;color:inherit;cursor:pointer}.u114 input[type=range]{min-width:0;width:100%;accent-color:var(--ux-accent)}.u114 .sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}.u114 .art{height:220px;background:var(--ux-surface-2);border:1px solid var(--ux-line-2);border-radius:4px;position:relative}.u114 svg{width:100%;height:100%}.u114 .path{fill:none;stroke:var(--ux-accent);stroke-width:4;stroke-linecap:round}.u114 .guide{fill:none;stroke:var(--ux-ink-2);stroke-width:1;stroke-dasharray:4 4}.u114 rect{fill:var(--ux-accent)}.u114 .handle{position:absolute;left:calc(var(--cx) - 22px);top:calc(var(--cy) - 22px);width:44px;height:44px;border:0;padding:0;background:transparent;touch-action:none;cursor:ns-resize}.u114 .handle:after{content:\"\";position:absolute;width:13px;height:13px;border-radius:50%;border:2px solid var(--ux-accent);background:var(--ux-surface);left:15px;top:15px}\n</style>\n<div class=\"ux u114\"><div class=\"art\"><svg viewBox=\"0 0 360 210\" preserveAspectRatio=\"none\" aria-label=\"벡터 곡선\"><path class=\"guide\"/><path class=\"path\"/><rect x=\"32\" y=\"102\" width=\"10\" height=\"10\"/><rect x=\"314\" y=\"102\" width=\"10\" height=\"10\"/></svg><button class=\"handle a\" data-i=\"0\" style=\"--cx:31.94%;--cy:19.05%\" aria-label=\"첫 제어점\" role=\"slider\" aria-valuemin=\"25\" aria-valuemax=\"185\" aria-valuenow=\"40\"></button><button class=\"handle b\" data-i=\"1\" style=\"--cx:68.06%;--cy:76.19%\" aria-label=\"둘째 제어점\" role=\"slider\" aria-valuemin=\"25\" aria-valuemax=\"185\" aria