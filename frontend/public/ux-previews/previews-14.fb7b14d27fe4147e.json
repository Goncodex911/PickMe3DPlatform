olor stop position"]]},{"id":"116","html":"<style>\n.u116{position:relative;width:340px;height:378px;padding:16px;box-sizing:border-box;border-radius:28px;background:var(--ux-surface);box-shadow:0 0 0 1px var(--ux-line),0 30px 60px -36px var(--ux-shadow-strong);color:var(--ux-ink);--p1:#E64980;--p2:#0CA678}\n.u116-top{display:flex;align-items:center;gap:8px;height:34px;padding:0 6px 0 12px;border-radius:12px;background:var(--ux-surface-2)}\n.u116-code{flex:1;min-width:0;font:700 12px/1 ui-monospace,SFMono-Regular,Menlo,monospace;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-variant-numeric:tabular-nums}\n.u116-code i{font-style:normal}.u116-code .a{color:var(--p1)}.u116-code .b{color:var(--p2)}\n.u116-cp{flex:none;height:26px;padding:0 10px;border:0;border-radius:8px;background:var(--ux-surface);box-shadow:0 0 0 1px var(--ux-line-2);color:var(--ux-ink-2);font-size:11.5px;font-weight:750}\n.u116-mid{display:flex;gap:10px;margin-top:10px}\n.u116-gr{position:relative;flex:none;width:176px;height:244px;touch-action:none}\n.u116-gr svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}\n.u116-h{position:absolute;left:0;top:0;width:20px;height:20px;margin:-10px 0 0 -10px;border:3px solid var(--c);border-radius:50%;padding:0;background:var(--ux-surface);box-shadow:0 2px 6px rgba(0,0,0,.2);cursor:grab;touch-action:none;transition:transform .2s var(--ux-spring)}\n.u116-h:hover,.u116-h.on{transform:scale(1.25)}\n.u116-h:focus-visible{outline:2px solid var(--ux-accent);outline-offset:3px}\n.u116-side{flex:1;display:flex;flex-direction:column;gap:6px;min-width:0}\n.u116-ps{height:34px;border:0;border-radius:10px;background:var(--ux-surface-2);color:var(--ux-ink-2);font-size:12px;font-weight:750;text-align:left;padding:0 10px;display:flex;align-items:center;gap:8px;transition:background-color .2s,color .2s}\n.u116-ps svg{flex:none;width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round}\n.u116-ps[aria-pressed=\"true\"]{background:var(--ux-ink);color:var(--ux-surface)}\n.u116-ax{margin-top:auto;font-size:10.5px;font-weight:700;color:var(--ux-ink-3);line-height:1.5}\n.u116-lanes{margin-top:10px;display:grid;gap:6px}\n.u116-ln{position:relative;height:24px;border-radius:12px;background:var(--ux-surface-2)}\n.u116-ln span{position:absolute;left:12px;top:50%;transform:translateY(-50%);font-size:10.5px;font-weight:750;color:var(--ux-ink-3)}\n.u116-bl{position:absolute;left:55px;top:3px;width:18px;height:18px;border-radius:50%;background:linear-gradient(135deg,var(--p1),#F59F00);box-shadow:0 3px 8px -3px var(--p1)}\n.u116-ln.lin .u116-bl{background:var(--ux-ink-3);opacity:.45;box-shadow:none}\n</style>\n<div class=\"ux u116\">\n  <div class=\"u116-top\"><code class=\"u116-code\" aria-live=\"polite\"></code><button class=\"u116-cp\" type=\"button\">복사</button></div>\n  <div class=\"u116-mid\">\n    <div class=\"u116-gr\">\n      <svg viewBox=\"0 0 176 244\" aria-hidden=\"true\">\n        <rect x=\"24\" y=\"80\" width=\"130\" height=\"130\" fill=\"color-mix(in srgb,var(--ux-ink) 3%,transparent)\"/><g stroke=\"var(--ux-line)\" stroke-width=\"1\"><path d=\"M24 80h130M24 112.5h130M24 145h130M24 177.5h130M24 210h130M24 80v130M56.5 80v130M89 80v130M121.5 80v130M154 80v130\"/></g>\n        <path d=\"M24 210 154 80\" stroke=\"var(--ux-ink-3)\" stroke-width=\"1.2\" stroke-dasharray=\"3 4\" fill=\"none\" opacity=\".6\"/>\n        <line class=\"u116-l1\" stroke=\"var(--p1)\" stroke-width=\"1.6\"/><line class=\"u116-l2\" stroke=\"var(--p2)\" stroke-width=\"1.6\"/>\n        <path class=\"u116-cv\" fill=\"none\" stroke=\"var(--ux-ink)\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n        <line class=\"u116-gy\" stroke=\"#F59F00\" stroke-width=\"1.2\" stroke-dasharray=\"2 3\"/>\n        <circle class=\"u116-dt\" r=\"5\" fill=\"#F59F00\" stroke=\"var(--ux-surface)\" stroke-width=\"2\"/>\n        <circle cx=\"24\" cy=\"210\" r=\"4\" fill=\"var(--ux-ink)\"/><circle cx=\"154\" cy=\"80\" r=\"4\" fill=\"var(--ux-ink)\"/>\n        <text x=\"21\" y=\"226\" font-size=\"10\" font-weight=\"700\" fill=\"var(--ux-ink-3)\">0</text><text x=\"154\" y=\"226\" text-anchor=\"end\" font-size=\"10\" font-weight=\"700\" fill=\"var(--ux-ink-3)\">시간</text><text x=\"10\" y=\"84\" font-size=\"10\" font-weight=\"700\" fill=\"var(--ux-ink-3)\">1</text><text x=\"0\" y=\"10\" font-size=\"10\" font-weight=\"700\" fill=\"var(--ux-ink-3)\">진행</text>\n      </svg>\n      <button class=\"u116-h\" type=\"button\" style=\"--c:var(--p1)\"></button><button class=\"u116-h\" type=\"button\" style=\"--c:var(--p2)\"></button>\n    </div>\n    <div class=\"u116-side\" role=\"group\" aria-label=\"프리셋\"></div>\n  </div>\n  <div class=\"u116-lanes\" aria-hidden=\"true\"><div class=\"u116-ln\"><i class=\"u116-bl\"></i><span>곡선</span></div><div class=\"u116-ln lin\"><i class=\"u116-bl\"></i><span>linear</span></div></div>\n</div>","js":"(function () {\n  var root = document.currentScript.previousElementSibling;\n  var gr = root.querySelector('.u116-gr'), cv = root.querySelector('.u116-cv'), l1 = root.querySelector('.u116-l1'), l2 = root.querySelector('.u116-l2');\n  var dt = root.querySelector('.u116-dt'), gy = root.querySelector('.u116-gy'), code = root.querySelector('.u116-code'), cp = root.querySelector('.u116-cp');\n  var hs = Array.prototype.slice.call(root.querySelectorAll('.u116-h')), side = root.querySelector('.u116-side');\n  var balls = Array.prototype.slice.call(root.querySelectorAll('.u116-bl'));\n  var rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n  var PRE = [['기본', 0.25, 0.1, 0.25, 1], ['부드럽게', 0.42, 0, 0.58, 1], ['튀어 오름', 0.34, 1.56, 0.64, 1], ['급감속', 0, 0, 0.2, 1]];\n  var X0 = 24, Y0 = 210, U = 130, LANE = 308 - 52 - 24;\n  var P = [0.25, 0.1, 0.25, 1];\n  function px(x) { return X0 + x * U; }\n  function py(y) { return Y0 - y * U; }\n  // CSS처럼 짧게: 0.25 → .25, 1.00 → 1\n  function f2(v) { var s = String(Math.round(v * 100) / 100); return s.replace(/^(-?)0\\./, '$1.'); }\n  // 시간 x에 대한 진행 y: x(t)를 뉴턴법으로 풀고(안 되면 이분법) 그 t로 y를 구합니다\n  function solve(x) {\n    var cx = 3 * P[0], bx = 3 * (P[2] - P[0]) - cx, ax = 1 - cx - bx, cy = 3 * P[1], by = 3 * (P[3] - P[1]) - cy, ay = 1 - cy - by;\n    var X = function (t) { return ((ax * t + bx) * t + cx) * t; };\n    var t = x;\n    for (var i = 0; i < 8; i++) { var e = X(t) - x, d = (3 * ax * t + 2 * bx) * t + cx; if (Math.abs(e) < 1e-5 || Math.abs(d) < 1e-6) break; t -= e / d; }\n    if (!(t >= 0 && t <= 1) || Math.abs(X(t) - x) > 1e-3) { var lo = 0, hi = 1; t = x; for (var j = 0; j < 30; j++) { if (X(t) < x) lo = t; else hi = t; t = (lo + hi) / 2; } }\n    return ((ay * t + by) * t + cy) * t;\n  }\n  PRE.forEach(function (p, i) {\n    var b = document.createElement('button'); b.type = 'button'; b.className = 'u116-ps';\n    var d = 'M2 16C' + (2 + p[1] * 14) + ' ' + (16 - p[2] * 14) + ' ' + (2 + p[3] * 14) + ' ' + (16 - p[4] * 14) + ' 16 2';\n    b.innerHTML = '<svg viewBox=\"0 0 18 18\" aria-hidden=\"true\"><path d=\"' + d + '\"/></svg><span></span>';\n    b.querySelector('span').textContent = p[0];\n    b.addEventListener('click', function () { tween(p.slice(1)); });\n    side.appendChild(b);\n  });\n  var ax = document.createElement('p'); ax.className = 'u116-ax'; ax.textContent = 'x 0–1 · y −0.4–1.6'; side.appendChild(ax);\n  var pbs = Array.prototype.slice.call(side.querySelectorAll('.u116-ps'));\n  function paint() {\n    cv.setAttribute('d', 'M' + px(0) + ' ' + py(0) + 'C' + px(P[0]) + ' ' + py(P[1]) + ' ' + px(P[2]) + ' ' + py(P[3]) + ' ' + px(1) + ' ' + py(1));\n    l1.setAttribute('x1', px(0)); l1.setAttribute('y1', py(0)); l1.setAttribute('x2', px(P[0])); l1.setAttribute('y2', py(P[1]));\n    l2.setAttribute('x1', px(1)); l2.setAttribute('y1', py(1)); l2.setAttribute('x2', px(P[2])); l2.setAttribute('y2', py(P[3]));\n    hs[0].style.left = px(P[0]) + 'px'; hs[0].style.top = py(P[1]) + 'px';\n    hs[1].style.left = px(P[2]) + 'px'; hs[1].style.top = py(P[3]) + 'px';\n    hs.forEach(function (h, i) { h.setAttribute('aria-label', '제어점 ' + (i + 1) + ': x ' + f2(P[i * 2]) + ', y ' + f2(P[i * 2 + 1])); });\n    code.innerHTML = 'cubic-bezier(<i class=\"a\">' + f2(P[0]) + ', ' + f2(P[1]) + '</i>, <i class=\"b\">' + f2(P[2]) + ', ' + f2(P[3]) + '</i>)';\n    pbs.forEach(function (b, i) { var q = PRE[i]; b.setAttribute('aria-pressed', String(Math.abs(q[1] - P[0]) + Math.abs(q[2] - P[1]) + Math.abs(q[3] - P[2]) + Math.abs(q[4] - P[3]) < 0.02)); });\n  }\n  function set(i, x, y) { P[i * 2] = Math.max(0, Math.min(1, x)); P[i * 2 + 1] = Math.max(-0.4, Math.min(1.6, y)); paint(); }\n  function tween(to) {\n    var from = P.slice(), t0 = performance.now();\n    (function f(now) {\n      var k = rm ? 1 : Math.max(0, Math.min(1, (now - t0) / 420)), e = 1 - Math.pow(1 - k, 3);\n      for (var i = 0; i < 4; i++) P[i] = from[i] + (to[i] - from[i]) * e;\n      paint();\n      if (k < 1) requestAnimationFrame(f);\n    })(t0);\n  }\n  // 끌기: 그래프 좌표로 바꿔 x는 0~1, y는 -0.3~1.3 안에서 움직입니다\n  hs.forEach(function (h, i) {\n    var on = false;\n    h.addEventListener('pointerdown', function (e) { on = true; h.classList.add('on'); try { h.setPointerCapture(e.pointerId); } catch (er) { /* 무시 */ } });\n    h.addEventListener('pointermove', function (e) {\n      if (!on) return;\n      var r = gr.getBoundingClientRect(), k = gr.offsetWidth / (r.width || 1);\n      set(i, ((e.clientX - r.left) * k - X0) / U, (Y0 - (e.clientY - r.top) * k) / U);\n    });\n    function up() { on = false; h.classList.remove('on'); }\n    h.addEventListener('pointerup', up);\n    h.addEventListener('pointercancel', up);\n    h.addEventListener('keydown', function (e) {\n      var s = e.shiftKey ? 0.01 : 0.05, d = { ArrowLeft: [-s, 0], ArrowRight: [s, 0], ArrowUp: [0, s], ArrowDown: [0, -s] }[e.key];\n      if (e.key === 'Escape') { e.preventDefault(); tween(PRE[0].slice(1)); return; }\n      if (!d) return;\n      e.preventDefault(); set(i, P[i * 2] + d[0], P[i * 2 + 1] + d[1]);\n    });\n 