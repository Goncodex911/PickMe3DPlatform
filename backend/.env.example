MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pickme3d?retryWrites=true&w=majority
JWT_SECRET=change-me
PORT=5001
FRONTEND_URL=http://localhost:3000

# Admin Console credentials
ADMIN_USERNAME=admin123
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com

# payOS — leave empty to use the local mock checkout
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# true forces the mock even when keys exist; false forces the real gateway
PAYMENT_MOCK=

# Slide Studio AI: endpoint kiểu OpenAI chat completions. Để trống dùng Pollinations miễn phí (không cần key, model openai-fast, khoảng 30 giây mỗi deck).
# Ví dụ Groq free:       SLIDE_AI_URL=https://api.groq.com/openai/v1/chat/completions  SLIDE_AI_MODEL=llama-3.3-70b-versatile
# Ví dụ Gemini free:     SLIDE_AI_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions  SLIDE_AI_MODEL=gemini-2.0-flash
# Ví dụ OpenRouter free: SLIDE_AI_URL=https://openrouter.ai/api/v1/chat/completions  SLIDE_AI_MODEL=<model có hậu tố :free>
SLIDE_AI_URL=
SLIDE_AI_MODEL=
SLIDE_AI_KEY=
SLIDE_AI_TIMEOUT_MS=60000
SLIDE_AI_MAX_TOKENS=3000
# true: không gọi AI, luôn dùng bộ mẫu dựng sẵn
SLIDE_AI_DISABLED=
