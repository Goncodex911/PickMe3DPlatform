MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pickme3d?retryWrites=true&w=majority
JWT_SECRET=change-me
PORT=5001
FRONTEND_URL=http://localhost:3000

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
# Admin Console fixed account
ADMIN_EMAIL=admin@example.com

# Automated Email Notifications (Gmail SMTP / Nodemailer)
# Hướng dẫn tạo mật khẩu ứng dụng Gmail (App Password) để gửi mail thật:
# 1. Bật xác thực 2 bước (2FA) trên tài khoản Google.
# 2. Truy cập https://myaccount.google.com/apppasswords
# 3. Tạo App Password (tên: PickMe3D) -> nhận mật khẩu 16 chữ cái.
# 4. Điền email và mật khẩu 16 chữ cái vào SMTP_USER và SMTP_PASS bên dưới:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Đặt true để cho phép gửi email kiểm thử tới cả tài khoản Admin (bỏ qua Admin Exclusion Rule trong lúc test):
ALLOW_ADMIN_EMAIL_FOR_TESTING=false

# payOS — leave empty to use the local mock checkout
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# true forces the mock even when keys exist; false forces the real gateway.
# Empty: mock ONLY on a local dev machine (no keys, FRONTEND_URL on localhost, NODE_ENV != production).
# A deployed server without payOS keys refuses checkout (503) instead of accepting fake payments.
PAYMENT_MOCK=
# Mock on NODE_ENV=production is blocked unless this is true (demo deployments only: anyone can "pay" for free).
ALLOW_MOCK_PAYMENT_IN_PRODUCTION=
# Minutes an unpaid order (and its payOS link) stays valid. 5–1440, default 15.
PAYMENT_ORDER_TTL_MINUTES=15
# Days after payment during which a customer can request a refund. Default 7.
REFUND_WINDOW_DAYS=7
# How often the payment job expires orders, re-verifies unknown payments and retries deliveries (ms, min 15000).
PAYMENT_JOB_INTERVAL_MS=60000
# payOS request timeout (ms)
PAYOS_TIMEOUT_MS=15000

# AI Slide pipeline (services/slidePipeline): Groq viết nội dung, Gemini (GEMINI_API_KEY bên dưới) làm Art Direction + bố cục.
# Thiếu key nào thì tầng đó tự hạ cấp: thiếu Groq -> Gemini viết nội dung; thiếu Gemini -> Design System/bố cục dựng theo luật.
GROQ_API_KEY=
# Model nội dung chính và chuỗi dự phòng (phân tách dấu phẩy). Để trống dùng mặc định.
SLIDE_CONTENT_MODEL=
SLIDE_CONTENT_FALLBACK_MODELS=
# Model Gemini cho Art Direction / Composition (dự phòng theo GEMINI_FALLBACK_MODELS)
SLIDE_DESIGN_MODEL=
# Thời gian chờ mỗi lần gọi model (ms)
SLIDE_AI_TIMEOUT_MS=60000
# true: không gọi AI, mọi tầng dựng theo luật
SLIDE_AI_DISABLED=
# (Cũ) services/slideAi.js một lượt gọi, không còn dùng cho /presentations/generate
SLIDE_AI_URL=
SLIDE_AI_MODEL=
SLIDE_AI_KEY=
SLIDE_AI_MAX_TOKENS=3000

# Optional deployment-managed promo codes (percent or fixed VND). No codes enabled by default.
# PROMO_CODES_JSON=[{"code":"WELCOME10","type":"percent","value":10,"plans":["pro"],"expiresAt":"2027-01-01T00:00:00Z"}]
PROMO_CODES_JSON=[]

# Gemini (quét bản vẽ 2D -> 3D và AI Render phối cảnh). Lấy key tại Google AI Studio.
GEMINI_API_KEY=
# Model dự phòng khi model chính quá tải/không có (phân tách dấu phẩy). Để trống dùng mặc định.
GEMINI_FALLBACK_MODELS=
# Thời gian chờ mỗi lần gọi model chữ/vision (ms)
AI_CALL_TIMEOUT_MS=75000
# AI Render: model sinh ảnh (cần bật billing, gói miễn phí có hạn mức sinh ảnh = 0)
GEMINI_IMAGE_MODEL=
GEMINI_IMAGE_FALLBACK_MODELS=
GEMINI_IMAGE_TIMEOUT_MS=90000

# Email + password login with the mock user DB (backend/src/data/mockUsers.js: admin / creator / buyer).
# Default: on outside production. true forces it on, false turns it off.
MOCK_AUTH=
# Demo account passwords (min 8 characters). Put them ONLY in backend/.env (git-ignored), never in the repo.
# MOCK_PASSWORD is the fallback for every account; MOCK_PASSWORD_<KEY> overrides one account. No password = that account cannot sign in.
MOCK_PASSWORD=
MOCK_PASSWORD_ADMIN=
MOCK_PASSWORD_CREATOR=
MOCK_PASSWORD_BUYER=
MOCK_PASSWORD_CUSTOMER=
MOCK_PASSWORD_USER1=
MOCK_PASSWORD_USER2=
